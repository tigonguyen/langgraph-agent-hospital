# Copy to .env and fill in. Loaded automatically (.env is gitignored — never commit it).
#
# Every variable here is optional: with none of them set, the project runs entirely
# on local Ollama, exactly as before.

# --- MODE: local (default) or api ----------------------------------------------
#   local -> everything runs on Ollama. The original behaviour; unset = this.
#   api   -> CHAT runs against the cloud endpoint below. In this mode a bare model
#            name is treated as `anthropic:<name>`, so it can't silently fall back
#            to Ollama.
#
# In `api` mode NOTHING runs locally — chat AND embeddings both go to the endpoint,
# so V0-V4 need no Ollama. Embeddings use AGENT_HOSPITAL_EMBED_BASE_URL if set, else
# ANTHROPIC_BASE_URL; that host must serve an OpenAI-style POST /v1/embeddings.
AGENT_HOSPITAL_MODE=local

# --- Which model the CLIs use by default ---------------------------------------
# Spec format is 'provider:model'; a bare name means Ollama in local mode. This is
# only the DEFAULT — an explicit `-m ...` on the command line always wins.
#   qwen2.5:14b                 -> local Ollama (local mode)
#   deepseek-v4-flash           -> in api mode, becomes anthropic:deepseek-v4-flash
#   anthropic:claude-opus-5     -> Anthropic, or your gateway (see below)
#   openai:gpt-4o / google:gemini-2.0-flash / openrouter:<org>/<model>
AGENT_HOSPITAL_MODEL=qwen2.5:7b

# --- Anthropic (or any Anthropic-compatible gateway) ---------------------------
# Used by the `anthropic:<model>` model spec, e.g. -m anthropic:claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...

# Custom endpoint — a gateway, proxy, or self-hosted relay. Unset = the public API
# (https://api.anthropic.com). The model name is passed through untouched, so an
# endpoint serving its own model is just `anthropic:<that-name>`.
ANTHROPIC_BASE_URL=https://your-gateway.example.com/v1

# --- Other cloud providers (optional) ------------------------------------------
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# --- Local Ollama --------------------------------------------------------------
# Used in `local` mode only. Unused in `api` mode.
# OLLAMA_HOST=http://localhost:11434

# --- Embeddings (V1-V4 retrieval) ----------------------------------------------
# In `api` mode these default to ANTHROPIC_BASE_URL; override here if embeddings
# live on a different host than chat. Setting EMBED_BASE_URL in `local` mode gives
# a local chat model with remote embeddings.
#
# !! A Chroma collection must be QUERIED with the same embedder it was BUILT with.
# !! Switching embedder against an existing store returns wrong neighbours
# !! SILENTLY — no error. Re-ingest into a new collection when you change it.
#   local  -> force Ollama embeddings even in api mode (chat remote, embeddings local;
#             use this when the chat gateway has no reachable /v1/embeddings)
#   <url>  -> OpenAI-style POST <url>/embeddings
# AGENT_HOSPITAL_EMBED_BASE_URL=local
AGENT_HOSPITAL_EMBED_MODEL=qwen3-embedding:4b
# AGENT_HOSPITAL_EMBED_API_KEY=          # falls back to ANTHROPIC_API_KEY if unset

# --- Tests ---------------------------------------------------------------------
# Model used by the live smoke tests; they auto-skip if it's unavailable.
# AGENT_HOSPITAL_TEST_MODEL=qwen2.5:7b
